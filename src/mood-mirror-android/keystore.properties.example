# Copy this file to keystore.properties and fill in the values for your local
# signing key. Never commit the copied file or the key itself.
# Prefer an absolute path outside the checkout; relative paths are resolved
# from this Android project directory. On Windows use forward slashes, e.g.
# C:/Users/you/keys/mood-mirror-release.p12 (not unescaped backslashes).
storeFile=/absolute/path/to/mood-mirror-release.p12
storePassword=REPLACE_WITH_YOUR_PASSWORD
keyAlias=mood-mirror-release
keyPassword=REPLACE_WITH_YOUR_PASSWORD
